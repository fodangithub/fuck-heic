<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibHeif.Native.Runtime" Version="1.20.2" />
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reuse the app's exact decoder so this is a true end-to-end test. -->
    <Compile Include="..\PhotoViewer\ImageDecoder.cs" Link="ImageDecoder.cs" />
    <Compile Include="..\PhotoViewer\HeicSanitizer.cs" Link="HeicSanitizer.cs" />
  </ItemGroup>
</Project>
