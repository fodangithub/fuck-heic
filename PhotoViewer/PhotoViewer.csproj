<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Folder layout (single-file dropped: native libheif.dll didn't self-extract reliably) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>

    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PhotoViewer</AssemblyName>
    <RootNamespace>PhotoViewer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Icons\*.png" />
  </ItemGroup>

  <!-- License texts, source offer, notices, and 512px icon references travel with the folder publish. -->
  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\licenses\**\*.*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Icons\Originals\**\*.*" Link="Icons\Originals\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibHeif.Native.Runtime" Version="1.20.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LibHeifSharp" Version="3.2.0" />
  </ItemGroup>

  <!-- publish drops the native libheif.dll (PrivateAssets native pkg quirk); copy it explicitly -->
  <Target Name="CopyNativeLibheif" AfterTargets="Publish">
    <ItemGroup>
      <_libheif Include="$(OutputPath)libheif.dll" Condition="Exists('$(OutputPath)libheif.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_libheif)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
