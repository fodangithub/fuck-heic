<Window x:Class="PhotoViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Viewer" Height="720" Width="1100"
        Icon="app.ico"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Image viewport -->
        <Border Grid.Row="0" Background="#FF1E1E1E" ClipToBounds="True">
            <Grid x:Name="Viewport">
                <Image x:Name="ImageHost"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5"
                       MouseWheel="ImageHost_MouseWheel"
                       MouseLeftButtonDown="ImageHost_MouseLeftButtonDown"
                       MouseLeftButtonUp="ImageHost_MouseLeftButtonUp"
                       MouseMove="ImageHost_MouseMove"
                       Cursor="SizeAll">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="RotateTransform" Angle="0"/>
                            <TranslateTransform x:Name="PanTransform" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>

                <!-- Empty-state / error message -->
                <TextBlock x:Name="HintText"
                           Text="Open an image (Ctrl+O) or drop a file here"
                           Foreground="#FF9A9A9A"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="#FF2B2B2B" Padding="10,6">
            <DockPanel>
                <TextBlock x:Name="StatusText" Foreground="#FFDDDDDD" FontSize="12"
                           DockPanel.Dock="Left" Text="Ready"/>
                <TextBlock x:Name="ZoomText" Foreground="#FF9A9A9A" FontSize="12"
                           DockPanel.Dock="Right" HorizontalAlignment="Right" Text="100%"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
